[package]
name = "ningmao-official-client-check"
version = "0.1.0"
edition = "2024"
license = "Apache-2.0"
publish = false
[dependencies]
localsend = { path = "__LOCALSEND_CORE__", default-features = false, features = ["http"] }
tokio = { version = "1", features = ["rt-multi-thread", "macros", "time", "fs"] }
tokio-util = { version = "0.7", features = ["rt", "io"] }
rcgen = { version = "0.14.8", default-features = false, features = ["crypto", "ring", "pem"] }
serde_json = "1"
sha2 = "0.10"
tempfile = "3"

bytes = "1"
futures-util = "0.3"
http-body = "1"
http-body-util = "0.1"
