{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ningmao M1-02 baseline probe",
  "version": "0.1.0",
  "identifier": "app.ningmao.m102baseline",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "柠猫 M1-02 · B 原生测试",
        "width": 520,
        "height": 760,
        "alwaysOnTop": true,
        "x": 30,
        "y": 30,
        "dragDropEnabled": true
      },
      {
        "label": "html-probe",
        "title": "Ningmao M1-02 HTML",
        "width": 520,
        "height": 720,
        "x": 580,
        "y": 30,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
