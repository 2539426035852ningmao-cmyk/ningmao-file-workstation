{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ningmao File Workstation",
  "version": "0.1.0",
  "identifier": "app.ningmao.fileworkstation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1431",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "柠猫文件工作站 0.1 集成候选",
        "width": 420,
        "height": 520,
        "minWidth": 340,
        "minHeight": 320,
        "center": true,
        "dragDropEnabled": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; media-src 'self' preview: http://preview.localhost https://preview.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost preview: http://preview.localhost https://preview.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
