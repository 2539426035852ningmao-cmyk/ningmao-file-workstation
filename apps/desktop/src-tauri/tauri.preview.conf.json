        "enableElevatedUpdateTask": false
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "柠猫文件工作站 · 紧凑架候选",
        "width": 420,
        "height": 520,
        "minWidth": 340,
        "minHeight": 320,
        "center": true,
        "dragDropEnabled": true
      }
    ]
  }
}
